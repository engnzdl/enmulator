{
  "productName": "Enmulator",
  "version": "0.1.0",
  "identifier": "com.enmulator.manager",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Enmulator",
        "width": 1100,
        "height": 750,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Cross-platform Android Emulator Manager",
    "longDescription": "Create, manage & spoof Android Virtual Devices with 30 pre-loaded device profiles. Built with Tauri 2 + Rust + React.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
